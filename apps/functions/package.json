{
  "name": "@sylvia/functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*.js",
  "scripts": {
    "build": "esbuild src/functions/*.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist/functions --external:@azure/functions --alias:@sylvia/core=../../packages/core/src/index.ts --out-extension:.js=.js",
    "typecheck": "tsc --noEmit",
    "start": "func start"
  },
  "dependencies": {
    "@azure/functions": "^4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0"
  }
}
